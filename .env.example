# ORDRIVA POS Environment Variables
# Blueprint Reference: Section 8.5

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://app:local_dev_password@localhost:5432/ordriva

# Next.js URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication & Security
SESSION_SECRET=ordriva_super_secret_session_key_replace_in_prod
ACCESS_TOKEN_TTL=15m
LOG_LEVEL=debug

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379

# Restaurant Specifics (India GST Default)
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CGST_RATE=2.5
DEFAULT_SGST_RATE=2.5
DEFAULT_SERVICE_CHARGE=5.0
